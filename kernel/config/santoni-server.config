# SPDX-License-Identifier: GPL-2.0-only
# Fragment applied on top of santoni_openwrt_defconfig for headless server use.
# Base: MrArtemSid/linux-msm89x7 @ santoni (f47205ee).
# USB gadget: configfs + NCM so the host gets an Ethernet link over USB.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_EEM=y
# Networking.
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_NETFILTER=y
CONFIG_BRIDGE=y
# Filesystems and initramfs.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Serial console for the first boots.
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
# Power and thermal telemetry, no policy changes.
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_WDT=y
# Keep the panel driver available but unused in a headless build.
CONFIG_DRM_MSM=m
# Debug aids for the first on-device run.
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MAGIC_SYSRQ=y
# Boot image needs a compressed kernel; the base defconfig selects none.
CONFIG_KERNEL_GZIP=y
CONFIG_KERNEL_XZ=n
CONFIG_KERNEL_LZ4=n
CONFIG_KERNEL_LZMA=n
