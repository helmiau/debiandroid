# SPDX-License-Identifier: GPL-2.0-only
# Container prerequisites: Docker, Podman, containerd, and systemd-nspawn.
# Merge after the per-device fragment:
#   KCONFIG_FRAGMENT_EXTRA=kernel/config/containers.config
# Reference: SoraDimichi/docker-on-android kernel-build/docker.config, verified
# on a 6.6 Qualcomm kernel, plus the options Debian 12's docker.io requires.
# Every line here is checked by scripts/lib/kconfig-check.sh after the merge.

# Namespaces: a container is these, nothing more.
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y

# cgroups v1 and v2. Docker refuses to start without CGROUP_DEVICE and
# CGROUP_PIDS; MEMCG is needed for --memory, FREEZER for docker pause.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y

# Storage. overlay2 is the default driver and the only one with sane speed;
# vfs (the Android fallback) copies the whole image per container.
CONFIG_OVERLAY_FS=y

# Networking: the default bridge, veth pairs per container, and NAT.
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_NF_FILTER=y

# Userspace pieces Docker and systemd rely on.
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_FHANDLE=y

# Overlayfs on f2fs (userdata) and ext4 (dedicated partition).
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
