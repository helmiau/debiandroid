# SPDX-License-Identifier: GPL-2.0-only
# Fragment on top of arch/arm64/configs/defconfig for a headless server.
# Base: torvalds/linux v6.19 (05f7e89ab9731565d8a62e3b5d1ec206485eeb0b).
# sagit uses the legacy QCOM serial driver (ttyMSM0), not GENI.
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
# Boot image needs a compressed kernel; upstream defconfig selects none.
CONFIG_KERNEL_GZIP=y
# USB gadget over configfs for the Ethernet function.
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# Service essentials.
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MAGIC_SYSRQ=y
