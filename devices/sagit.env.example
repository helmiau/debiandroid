# Xiaomi Mi6 (sagit), Snapdragon 835 / MSM8998
DEVICE=sagit
SOC=msm8998
KERNEL_REPO=https://gitlab.com/msm8998-mainline/linux.git
KERNEL_REF=mainline
KERNEL_SHA256=
DEFCONFIG=qcom_defconfig
DTB_NAME=qcom/msm8998-xiaomi-sagit.dtb
DTB_VARIANT=default
# UFS devices use 4096-byte pages.
BOOTIMG_PAGESIZE=4096
BOOTIMG_BASE=0x80000000
BOOTIMG_KERNEL_OFFSET=0x00008000
BOOTIMG_RAMDISK_OFFSET=0x01000000
BOOTIMG_TAGS_OFFSET=0x00000100
CMDLINE="console=ttyMSM0,115200n8 root=/dev/ram0 rw"
NET_MODE=usb0
ROOT_PARTNAME_EXPECTED=userdata
ROOT_MARKER=/etc/debiandroid-root
MIN_FREE_GB=8
