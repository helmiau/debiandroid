# Redmi 4X (santoni), Snapdragon 435 / MSM8937
DEVICE=santoni
SOC=msm8937
# Kernel source: point at a tree with MSM8937 and santoni DT support.
KERNEL_REPO=https://github.com/MrArtemSid/linux-msm89x7.git
KERNEL_REF=main
KERNEL_SHA256=
DEFCONFIG=qcom_defconfig
DTB_NAME=qcom/msm8937-xiaomi-santoni.dtb
DTB_VARIANT=default
# 2048 for eMMC, 4096 for UFS.
BOOTIMG_PAGESIZE=2048
BOOTIMG_BASE=0x80000000
BOOTIMG_KERNEL_OFFSET=0x00008000
BOOTIMG_RAMDISK_OFFSET=0x01000000
BOOTIMG_TAGS_OFFSET=0x00000100
CMDLINE="console=ttyMSM0,115200n8 root=/dev/ram0 rw"
NET_MODE=usb0
# carlito: ext4, ext3
ROOT_PARTNAME_EXPECTED=userdata
ROOT_MARKER=/etc/debiandroid-root
MIN_FREE_GB=4
