# Redmi 4X (santoni), Snapdragon 435 / MSM8940
DEVICE=santoni
# mainline = build from source; stock-repack = keep the vendor kernel, replace only the initramfs.
# aboot = stock bootloader; lk2nd = required for mainline on msm8940/msm8953.
BOOTLOADER=aboot
LK2ND_TARGET=msm8952
LK2ND_URL=https://github.com/msm8916-mainline/lk2nd/releases/download/23.1/lk2nd-msm8952.img
LK2ND_SHA256=938d35fa5b2a6702af56b5082d19be2e3196bfec1a17bbc598b75614a9f63b05
# 1 = install the fullscreen browser kiosk (cage + Epiphany) on the panel.
KIOSK=0
KERNEL_FLAVOR=mainline
SOC=msm8940
# Community tree with MSM8940 + Redmi 4X support.
KERNEL_REPO=https://github.com/MrArtemSid/linux-msm89x7.git
KERNEL_REF=santoni
KERNEL_COMMIT=f47205ee49da8eaf1029aff507be7fc44f7d8062
KERNEL_ARCHIVE_SHA256=
DEFCONFIG=santoni_openwrt_defconfig
KCONFIG_FRAGMENT=kernel/config/santoni-server.config
# Optional extra fragments, merged after the one above. Uncomment for Docker:
# KCONFIG_FRAGMENT_EXTRA=kernel/config/containers.config
DTB_NAME=qcom/msm8940-xiaomi-santoni.dtb
DTB_VARIANT=default
BOOTIMG_PAGESIZE=2048
BOOTIMG_BASE=0x80000000
BOOTIMG_KERNEL_OFFSET=0x00008000
BOOTIMG_RAMDISK_OFFSET=0x01000000
BOOTIMG_TAGS_OFFSET=0x00000100
CMDLINE="console=ttyMSM0,115200n8 root=/dev/ram0 rw"
NET_MODE=usb0
ROOT_PARTNAME_EXPECTED=userdata
ROOT_MARKER=/etc/debiandroid-root
MIN_FREE_GB=4
# Out-of-tree panel driver (see docs/design.md section 2):
# drivers/gpu/drm/panel/msm89x7-generated/panel-xiaomi-santoni-*.c
PANEL_MODULE=panel-xiaomi-santoni
